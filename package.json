{
  "name": "proyectdungeon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProyectDungeon development harness and experiment shell",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/validate-docs.mjs",
    "config:check": "node scripts/validate-opencode.mjs",
    "tasks:board": "node scripts/task-board.mjs",
    "tasks:next": "node scripts/next-task.mjs",
    "verify": "pnpm run docs:check && pnpm run config:check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0",
    "yaml": "^2.7.0"
  }
}
